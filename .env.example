# docker-compose üçün nümunə. Kopyala: cp .env.example .env
# .env faylı git-ə GETMİR (.gitignore-dadır).

# Gateway, auth və chat servisləri EYNİ dəyəri işlətməlidir.
# Produksiyada mütləq YENİSİNİ yarat - bu dəyər lokal inkişaf üçündür.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Servislərarası çağırışlar üçün paylaşılan token
INTERNAL_SERVICE_TOKEN=local-dev-internal-token

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=p1234

# Şifrə sıfırlama və email təsdiqi linklərinin göstərdiyi ünvan
FRONTEND_URL=http://localhost:5500

# Frontend-in hansı ünvandan gələcəyi (produksiyada dəqiq domen yaz, "*" qoyma)
CORS_ALLOWED_ORIGINS=*

# AI Studiya üçün Gemini açarı (boş qalsa yalnız AI bölməsi işləməyəcək)
KEY=

# Email: lokalda mailpit tutur, heç nə internetə çıxmır.
# Produksiyada Resend: MAIL_HOST=smtp.resend.com, MAIL_PORT=587, MAIL_USERNAME=resend,
# MAIL_PASSWORD=<API açarı>, MAIL_FROM=<təsdiqlənmiş domendeki ünvan>.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy
# Göndərən ünvan. Resend-də təsdiqlənmiş domendə olmalıdır (məs. noreply@kananpeoiks.me).
MAIL_FROM=signum@localhost
